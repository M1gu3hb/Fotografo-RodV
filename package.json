{
  "name": "the-best-moment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .render && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "audit:photos": "python scripts/audit-photos.py",
    "generate:gallery": "python scripts/process-photos.py",
    "verify:photos": "python scripts/verify-photos.py",
    "seed:supabase": "node scripts/generate-supabase-seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
